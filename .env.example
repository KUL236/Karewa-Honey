# Copy to .env for local use. On Netlify add the SAME names under Site settings -> Environment variables,
# then redeploy (Deploys -> Trigger deploy -> Clear cache and deploy site). Names must start with VITE_.

# --- EmailJS (enquiry form) ---
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
# Use ONE template for all forms ...
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# ... or (optional) a separate one per form:
# VITE_EMAILJS_TEMPLATE_WEBSITE=template_xxxxxxx
# VITE_EMAILJS_TEMPLATE_WHOLESALE=template_xxxxxxx
# VITE_EMAILJS_TEMPLATE_CHATBOT=template_xxxxxxx
# VITE_EMAILJS_TO_EMAIL=Karewabee@gmail.com

# --- Supabase (admin panel + live content). Project Settings -> API ---
# Only the URL and the anon/publishable key. NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
